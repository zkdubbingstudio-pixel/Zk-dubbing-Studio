rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Only allow Super Admin (zkdubbingstudio@gmail.com) with verified token email to upload/replace/delete catalog assets
    function isSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'zkdubbingstudio@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAllowedImageUpload() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAllowedVideoUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|x-matroska|mkv)');
    }

    // Prevent directory listing globally across all paths
    match /{allPaths=**} {
      allow list: if false;
      allow get: if isSuperAdmin();
      allow write: if false;
    }

    // Published catalog image assets (posters, banners, episode thumbnails, seasons, media)
    match /{folder}/{fileName} {
      allow list: if false;
      allow get: if folder in ['posters', 'banners', 'episode-thumbnails', 'thumbnails', 'seasons', 'media', 'avatars'] || isSuperAdmin();
      allow create, update: if isSuperAdmin() && folder in ['posters', 'banners', 'episode-thumbnails', 'thumbnails', 'seasons', 'media', 'avatars'] && isAllowedImageUpload();
      allow delete: if isSuperAdmin();
    }

    // Authenticated user avatar uploads scoped to own UID
    match /avatars/{userId}/{fileName} {
      allow list: if false;
      allow get: if true;
      allow create, update: if (isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId)) && isAllowedImageUpload();
      allow delete: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Episode & movie video uploads hosted directly in Firebase Storage (owner-only writes, nested folders)
    match /videos/{allVideoPaths=**} {
      allow list: if false;
      allow get: if true;
      allow create, update: if isSuperAdmin() && isAllowedVideoUpload();
      allow delete: if isSuperAdmin();
    }
  }
}
