rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'zkdubbingstudio@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isSuperAdmin();
    }
    match /anime/{animeId} {
      allow read, write: if true;
    }
    match /seasons/{seasonId} {
      allow read, write: if true;
    }
    match /episodes/{episodeId} {
      allow read, write: if true;
    }
    match /favorites/{favoriteId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    match /history/{historyId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /analytics/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /login_history/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin());
    }
  }
}
